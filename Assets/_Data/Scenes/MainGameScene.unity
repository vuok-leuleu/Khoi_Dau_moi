--- !u!114 &289936709
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 289936708}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 07f227ffaf9425a47a33fb0c15f70024, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CampaignTutorialManager
  currentStage: 0
  overlayDim: {fileID: 1922971438}
  handPointer: {fileID: 916600558}
  highlightRing: {fileID: 260425794}
  pointerOffset: {x: 30, y: 30}
  tutorialCanvas: {fileID: 1417529758}
  buildShopCanvas: {fileID: 357206413}
  hintText: {fileID: 1811991}
  warningText: {fileID: 425651800}
  redFlashOverlay: {fileID: 1922971440}
  warningBannerPanel: {fileID: 0}
  runningWarningText: {fileID: 425651800}
  townHallBuilding: {fileID: 578145078}
  riceStorageBuilding: {fileID: 1325065914}
  pointerMoveSpeed: 6
  bobbingSpeed: 3
  bobbingAmount: 1
  stage1Dialogues:
  - speakerName: "Gi\xE0 l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "\"Th\u01B0a L\xE3nh ch\xFAa! C\u0103n c\u1EE9 c\u1EE7a ch\xFAng ta
      v\u1EEBa tr\u1EA3i qua m\u1ED9t tr\u1EADn t\u1EADp k\xEDch t\xE0n kh\u1ED1c
      t\u1EEB phe \u0111\u1ED1i l\u1EADp...\""
  - speakerName: "Gi\xE0 l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "\"Nh\xE0 Ch\xEDnh, Kho L\xFAa v\xE0 Th\xE1p Cung \u0111\u1EC1u \u0111\xE3
      b\u1ECB san ph\u1EB3ng! Ch\xFAng ta c\u1EA7n kh\xF4i ph\u1EE5c l\u1EA1i ngay
      \u0111\u1EC3 t\xE1i thi\u1EBFt c\u0103n c\u1EE9!\""
  - speakerName: "Gi\xE0 l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "\"H\xE3y b\u1EA5m v\xE0o t\u1EEBng c\xF4ng tr\xECnh t\xE0n t\xEDch
      v\xE0 ch\u1ECDn S\u1EEDa Ch\u1EEFa theo h\u01B0\u1EDBng d\u1EABn!\""
  stage2Dialogues:
  - speakerName: "Gi\xE0 l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "\"T\u1ED1t l\u1EAFm! C\u0103n c\u1EE9 c\u01A1 b\u1EA3n \u0111\xE3 tho\xE1t
      kh\u1ECFi t\xECnh tr\u1EA1ng \u0111\u1ED5 n\xE1t. Tuy nhi\xEAn, ngu\u1ED3n
      t\xE0i nguy\xEAn d\u1EF1 tr\u1EEF \u0111ang c\u1EA1n ki\u1EC7t.\""
  - speakerName: "Gi\xE0 l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "\"Ch\xFAng ta c\u1EA7n g\u1ED7 v\xE0 \u0111\xE1 \u0111\u1EC3 ph\xE1t
      tri\u1EC3n l\xE2u d\xE0i. H\xE3y m\u1EDF C\u1EEDa H\xE0ng X\xE2y D\u1EF1ng
      v\xE0 \u0111\u1EB7t nh\xE0 Khai Th\xE1c G\u1ED7 c\xF9ng Kho \u0110\xE1!\""
  stage3Dialogues:
  - speakerName: "Gi\xE0 l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "Th\u1EBF l\xE0 ti\u1EBFng b\xFAa ti\u1EBFng \u0111\u1EE5c \u0111\xE3
      vang l\xEAn r\u1ED3i! Nh\u01B0ng c\xE1i kho n\xE0y b\xE9 qu\xE1, gom \u0111\u01B0\u1EE3c
      t\xED g\u1ED7 \u0111\xE1 \u0111\xE3 \u0111\u1EA7y tr\xE0n, sao l\xE0m n\xEAn
      vi\u1EC7c l\u1EDBn \u0111\u01B0\u1EE3c?"
  - speakerName: "Gi\xE0 l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "\"L\xE3nh ch\xFAa h\xE3y ch\u1ECDn nh\xE0 Khai Th\xE1c G\u1ED7 v\xE0
      ti\u1EBFn h\xE0nh N\xE2ng C\u1EA5p \u0111\u1EC3 t\u0103ng s\u1EA3n l\u01B0\u1EE3ng
      khai th\xE1c!\""
  stageExpandLandDialogues:
  - speakerName: "Gi\xE0 l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "Th\u01B0a L\xE3nh Ch\xFAa! D\xE2n c\u1EF1u t\xECm v\u1EC1 ng\xE0y m\u1ED9t
      \u0111\xF4ng, di\u1EC7n t\xEDch \u0111\u1EA5t trong l\xF2ng th\xE0nh l\u0169y
      hi\u1EC7n t\u1EA1i \u0111\xE3 ch\u1EADt h\u1EB9p, kh\xF4ng \u0111\u1EE7 ch\u1ED7
      \u0111\u1EC3 \u0111\u1EB7t th\xEAm c\xF4ng tr\xECnh m\u1EDBi r\u1ED3i!"
  - speakerName: "Gi\xE0 l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "H\xE3y ch\xFA \xFD c\xE1c bi\u1EC3u t\u01B0\u1EE3ng M\u1EDF R\u1ED9ng
      (+)! Nh\u1EA5n v\xE0o \u0111\xF3 \u0111\u1EC3 \u0111\u1EADp b\u1ECF t\u01B0\u1EDDng
      c\u0169, khai hoang th\xEAm m\u1ED9t d\u1EA3i \u0111\u1EA5t m\u1EDBi v\xE0
      m\u1EDF r\u1ED9ng b\u1EDD c\xF5i l\xE0ng ta!"
  stage4Dialogues:
  - speakerName: "Gi\xE0 l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "Nguy r\u1ED3i con \u01A1i! \u0110\xE1m th\u1EE3 r\u1EEBng v\u1EEBa
      h\u1ED1t ho\u1EA3ng ch\u1EA1y v\u1EC1 b\xE1o c\xF3 d\u1EA5u ch\xE2n qu\xE1i
      th\xFA xu\u1EA5t hi\u1EC7n ngay ngo\xE0i b\xECa r\u1EEBng k\xECa!"
  - speakerName: "Gi\xE0 l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "Lo l\xE0m \u0103n th\xF4i ch\u01B0a \u0111\u1EE7, \"an c\u01B0 m\u1EDBi
      l\u1EADp nghi\u1EC7p\" \u0111\u01B0\u1EE3c! Con m\u1EDF ngay C\u1EEDa H\xE0ng,
      chuy\u1EC3n sang trang **Qu\xE2n S\u1EF1** c\u1EAFm m\u1ED9t c\xE1i **Th\xE1p
      Canh** \u0111\u1EC3 b\u1EA3o v\u1EC7 l\xE0ng ngay!"
  stage5WarningDialogues:
  - speakerName: "Gi\xE0 l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "B\xC1O \u0110\u1ED8NG! B\xC1O \u0110\u1ED8NG! L\u0169 qu\xE1i t\xE0
      \u0111\xE3 ng\u1EEDi th\u1EA5y h\u01A1i ng\u01B0\u1EDDi, \u0111ang r\u1EA7n
      r\u1EA7n lao v\u1EC1 ph\xEDa c\u0103n c\u1EE9 k\xECa con \u01A1i!"
  - speakerName: "Gi\xE0 l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "B\xE0 con d\xE2n l\xE0ng chu\u1EA9n b\u1ECB! H\xE3y \u0111\u1EC3 Th\xE1p
      Canh tr\xFAt m\u01B0a t\xEAn gi\u1ED9i xu\u1ED1ng \u0111\u1EA7u b\u1ECDn ch\xFAng,
      cho ch\xFAng n\xF3 m\u1ED9t b\xE0i h\u1ECDc!"
  stage6CompleteDialogues:
  - speakerName: "Gi\xE0 l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "Hoan h\xF4! Th\u1EAFng r\u1ED3i! Th\xE1p canh b\u1EAFn r\u1EE5ng s\u1EA1ch
      b\xE1ch l\u0169 qu\xE1i v\u1EADt r\u1ED3i con \u01A1i. \u0110\xFAng l\xE0 t\xE0i
      kh\xF4ng \u0111\u1EE3i tu\u1ED5i!"
  - speakerName: "Gi\xE0 l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "Ta \u0111\xE3 gom g\xF3p ch\xFAt v\u1ED1n li\u1EBFng c\u1EE7a d\xE2n
      l\xE0ng c\u1EA5t v\xE0o kho cho con r\u1ED3i \u0111\u1EA5y. T\u1EEB nay, v\u1EADn
      m\u1EC7nh x\xF3m l\xE0ng n\xE0y giao tr\u1ECDn v\xE0o tay con. H\xE3y d\u1EABn
      d\u1EAFt l\xE0ng ta tr\u1EDF l\u1EA1i th\u1EDDi ho\xE0ng kim nh\xE9, Tr\xE1ng
      s\u0129!"

--- !u!114 &935170697
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 935170694}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 07f227ffaf9425a47a33fb0c15f70024, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CampaignTutorialManager
  currentStage: 0
  overlayDim: {fileID: 1209662178}
  handPointer: {fileID: 647387464}
  highlightRing: {fileID: 647387465}
  tutorialCanvas: {fileID: 36732149}
  hintText: {fileID: 993098656}
  baseZone: {fileID: 1977744099}
  enemyZone: {fileID: 1567306135}
  enemySpawner: {fileID: 0}
  tutorialEnemyCount: 1
  outpostAttackButton: {fileID: 0}
  stage1Dialogues:
  - speakerName: "Tr\u01B0\u1EDDng l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "\"Ch\xE0o m\u1EEBng b\u1EA1n \u0111\u1EBFn v\u1EDBi v\xF9ng \u0111\u1EA5t
      Zeffira. H\xE3y b\u1EAFt \u0111\u1EA7u ph\xE1t tri\u1EC3n v\u01B0\u01A1ng qu\u1ED1c
      c\u1EE7a ch\xFAng ta.\""
  - speakerName: "Tr\u01B0\u1EDDng l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "\"Khi qua ng\xE0y m\u1EDBi, c\xE1c c\xF4ng tr\xECnh s\u1EBD cung c\u1EA5p
      t\xE0i nguy\xEAn cho v\u01B0\u01A1ng qu\u1ED1c c\u1EE7a b\u1EA1n.\""
  stage2Dialogues:
  - speakerName: "Tr\u01B0\u1EDDng l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "\"K\u1EBB \u0111\u1ECBch ph\xEDa tr\u01B0\u1EDBc \u0111ang r\xECnh
      r\u1EADp v\u01B0\u01A1ng qu\u1ED1c. Ch\xFAng ta c\u1EA7n x\xE2y d\u1EF1ng Tr\u1EA1i
      L\xEDnh \u0111\u1EC3 s\u1EB5n s\xE0ng l\u1EF1c l\u01B0\u1EE3ng ph\xF2ng th\u1EE7.\""
  stage3Dialogues:
  - speakerName: "Tr\u01B0\u1EDDng l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "\"K\u1EBB \u0111\u1ECBch \u0111\xE3 ph\xE1t hi\u1EC7n ra ta v\xE0 t\u1EA5n
      c\xF4ng tr\u01B0\u1EDBc!\""
  stage4Dialogues:
  - speakerName: "Tr\u01B0\u1EDDng l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "\"Ph\xF2ng th\u1EE7 th\xE0nh c\xF4ng! L\u1EF1c l\u01B0\u1EE3ng c\u1EE7a
      ta \u0111\xE3 \u0111\u1EA9y l\xF9i \u0111\u01B0\u1EE3c \u0111\u1EE3t t\u1EA5n
      c\xF4ng c\u1EE7a k\u1EBB \u0111\u1ECBch.\"  "
  stage5Dialogues:
  - speakerName: "Tr\u01B0\u1EDDng l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "\"\u0110\xE3 ti\xEAu di\u1EC7t to\xE0n b\u1ED9 l\u1EF1c l\u01B0\u1EE3ng
      \u0111\u1ECBch v\xE0 chi\u1EBFm \u0111\xF3ng th\xE0nh c\xF4ng v\xF9ng \u0111\u1EA5t
      m\u1EDBi!\"  "
  stageCompleteDialogues:
  - speakerName: "Tr\u01B0\u1EDDng l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "\"H\xE3y x\xE2y d\u1EF1ng Nh\xE0 Ch\xEDnh m\u1EDBi tr\xEAn v\xF9ng
      \u0111\u1EA5t v\u1EEBa chi\u1EBFm \u0111\xF3ng \u0111\u1EC3 kh\u1EB3ng \u0111\u1ECBnh
      ch\u1EE7 quy\u1EC1n.\"  "
  - speakerName: "Tr\u01B0\u1EDDng l\xE0ng"
    speakerAvatar: {fileID: -1410745400, guid: 012c4f79dcfed8c4591f242ba9a517de, type: 3}
    message: "\"Ch\xFAc m\u1EEBng b\u1EA1n \u0111\xE3 ho\xE0n th\xE0nh h\u01B0\u1EDBng
      d\u1EABn v\xE0 m\u1EDF r\u1ED9ng l\xE3nh th\u1ED5 th\xE0nh c\xF4ng!\"  "
